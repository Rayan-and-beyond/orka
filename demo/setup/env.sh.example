# Copy to demo/setup/env.sh and adjust. Sourced by every demo. No secrets:
# tokens are minted from the cluster at run time.
export KUBECONFIG="$HOME/projects/orka-demos/bin/substrate-eval/kubeconfig"
export ORKA_NAMESPACE=orka-system
export ORKA_RUNTIME_NAMESPACE=orka-runtimes
export ORKA_API=http://127.0.0.1:8080
export ORKA_API_SERVICE=orka-api
export DEMO_REPO=https://github.com/sozercan/orka-demo-inventory
export DEMO_REPO_BRANCH=main
export DEMO_GIT_SECRET=github-credentials
